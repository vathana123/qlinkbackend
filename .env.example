# Copy to .env for local development; Spring Boot imports it as Java properties.
# Use KEY=value, no export prefix or shell quotes. OS variables override these values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qlink_db
DB_USERNAME=root
DB_PASSWORD=
JWT_ISSUER=qlink-api
JWT_PRIVATE_KEY=file:./secrets/private.pem
JWT_PUBLIC_KEY=file:./secrets/public.pem
GOOGLE_CLIENT_ID=66607447341-57pg2483cp73jo2geh525sa1ucm1b7os.apps.googleusercontent.com
# Comma-separated Android OAuth CLIENT IDs from the same Cloud project, not package names.
GOOGLE_ANDROID_CLIENT_IDS=66607447341-276mjnoog2vbe22l09r7gril5ih5ioh3.apps.googleusercontent.com
APPLE_CLIENT_IDS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Native STOMP /ws origins; set explicit HTTPS frontend origins in production (no wildcards).
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.0.2.2:8080

# Storage: dev default ./storage/dev; prod default /var/lib/qlink/storage
# STORAGE_ROOT=/var/lib/qlink/storage
STORAGE_MAX_FILE_SIZE=25MB
