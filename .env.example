# Copy to .env for local development; Spring Boot imports it as Java properties.
# Use KEY=value, no export prefix or shell quotes. OS variables override these values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qlink_db
DB_USERNAME=root
DB_PASSWORD=
# Physical Android: USB uses adb reverse and loopback; Wi-Fi uses the PC LAN IP.
# Spring Boot accepts these variables without changing application.yml.
# SERVER_ADDRESS=127.0.0.1
# SERVER_PORT=8080
JWT_ISSUER=qlink-api
JWT_PRIVATE_KEY=file:./secrets/private.pem
JWT_PUBLIC_KEY=file:./secrets/public.pem
GOOGLE_CLIENT_ID=66607447341-57pg2483cp73jo2geh525sa1ucm1b7os.apps.googleusercontent.com
# Comma-separated Android OAuth CLIENT IDs from the same Cloud project, not package names.
GOOGLE_ANDROID_CLIENT_IDS=66607447341-276mjnoog2vbe22l09r7gril5ih5ioh3.apps.googleusercontent.com
APPLE_CLIENT_IDS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Native STOMP /ws origins; set explicit HTTPS frontend origins in production (no wildcards).
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.0.2.2:8080

# Storage: dev default ./storage/dev; prod default /var/lib/qlink/storage
# STORAGE_ROOT=/var/lib/qlink/storage
STORAGE_MAX_FILE_SIZE=25MB

# Optional FCM: use the same Firebase project as Android google-services.json.
# Keep ADC/service-account credentials outside this repository. Leave push off
# until credentials and the FCM HTTP v1 API are configured.
# PUSH_ENABLED=true
# FIREBASE_PROJECT_ID=your-firebase-project
# Google ADC reads the process environment, not Spring properties. run-dev.ps1
# imports this path from .env; direct Gradle/IDE launches need an environment var.
# GOOGLE_APPLICATION_CREDENTIALS=C:/outside-repository/service-account.json
# PowerShell: $env:GOOGLE_APPLICATION_CREDENTIALS='C:/outside-repository/service-account.json'
# See docs/FCM_DIAGNOSTICS.md for the two-emulator verification procedure.
